# Meza Dawa backend configuration
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/meza_dawa
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DOCTOR_ACCESS_CODE=DOC2026
PHARMACY_ACCESS_CODE=PH2026

TALKSASA_API_KEY=
TALKSASA_SENDER_ID=MezaDawa
# Keep the TalkSasa API key server-side. Get it from your TalkSasa SMS portal.
TALKSASA_API_URL=https://bulksms.talksasa.com/api/v3/sms/send

APP_ENV=development
FRONTEND_URL=http://localhost:5500

# Safaricom Daraja M-Pesa (server-side only)
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://YOUR-BACKEND-DOMAIN/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
SMS_TOKEN_PACKAGE_PRICE=30
SMS_TOKEN_PACKAGE_SIZE=100
